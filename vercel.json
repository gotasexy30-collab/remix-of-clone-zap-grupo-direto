{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/redirecionar",
      "destination": "/redirecionar.html"
    },
    {
      "source": "/j",
      "destination": "/redirecionar.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
